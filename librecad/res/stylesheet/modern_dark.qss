/* AutoCAD Dark Theme for LibreCAD */
/* Window Background: #1E2229 (Hitam kebiruan) */
/* Darker Areas (Inactive tabs, status bar): #15181D */
/* Borders: #111418 */
/* Text: #E0E6ED */
/* Accent/Selected: #184F8D (Blue) */
/* Hover: #2D333B */
/* Canvas: #212830 */
/* Inputs: #111418 */

QMainWindow, QDialog {
    background-color: #1E2229;
    color: #E0E6ED;
}

QWidget {
    background-color: #1E2229;
    color: #E0E6ED;
    font-family: "Segoe UI", "Inter", Arial, sans-serif;
    font-size: 11px;
}

/* Toolbars */
QToolBar {
    background-color: #1E2229;
    border: none;
    border-bottom: 1px solid #111418;
    spacing: 1px;
    padding: 2px 1px;
}

QToolBar::separator {
    background-color: #111418;
    width: 1px;
    margin: 4px 8px;
}

QToolBar::handle {
    background-color: #2D333B;
    background-image: url(none);
    border-radius: 2px;
    width: 6px;
    height: 20px;
    margin: 2px 1px;
    subcontrol-origin: content;
}

QToolButton {
    background-color: transparent;
    color: #E0E6ED;
    border: 1px solid transparent;
    border-radius: 2px;
    padding: 5px;
    margin: 1px;
}

QToolButton:hover {
    background-color: #2D333B;
    border: 1px solid #636A73;
}

QToolButton:pressed, QToolButton:checked {
    background-color: #184F8D;
    border: 1px solid #306BB5;
    color: #FFFFFF;
}

/* Dock Widgets (Panels) */
QDockWidget {
    background-color: #1E2229;
    color: #E0E6ED;
    titlebar-close-icon: url();
    titlebar-normal-icon: url();
    border: 1px solid #111418;
}

QDockWidget::title {
    background-color: #15181D;
    color: #E0E6ED;
    padding: 6px 8px;
    text-align: left;
    border-bottom: 1px solid #111418;
    font-weight: bold;
}

QDockWidget > QWidget {
    background-color: #1E2229;
}

/* Menus */
QMenuBar {
    background-color: #15181D;
    color: #E0E6ED;
    border-bottom: 1px solid #111418;
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 12px;
}

QMenuBar::item:selected {
    background-color: #2D333B;
}

QMenu {
    background-color: #1E2229;
    color: #E0E6ED;
    border: 1px solid #111418;
}

QMenu::item {
    padding: 6px 24px 6px 12px;
}

QMenu::item:selected {
    background-color: #184F8D;
    color: #FFFFFF;
}

/* Status Bar */
QStatusBar {
    background-color: #15181D;
    color: #E0E6ED;
    border-top: 1px solid #111418;
}

QStatusBar::item {
    border: none;
    border-right: 1px solid #111418;
}

QStatusBar QLabel {
    color: #E0E6ED;
    padding: 0 8px;
    background-color: transparent;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #111418;
    border-top: 1px solid #4A8CDA; /* Accent line for active tab */
    background-color: #1E2229;
}

QTabBar::tab {
    background-color: #15181D;
    color: #A0AAB5;
    padding: 6px 16px;
    border: 1px solid #111418;
    border-bottom: none;
    margin: 1px 1px 0 0;
}

QTabBar::tab:selected {
    background-color: #1E2229;
    color: #FFFFFF;
    border-top: 2px solid #4A8CDA; /* AutoCAD blue accent */
    border-left: 1px solid #111418;
    border-right: 1px solid #111418;
}

QTabBar::tab:hover:!selected {
    background-color: #42474E;
    color: #E0E6ED;
}

QTabBar::close-button {
    subcontrol-position: right;
    margin: 2px;
}

QTabBar::close-button:hover {
    background-color: #E81123;
    border-radius: 2px;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: #15181D;
    width: 12px;
    margin: 0px;
    border-left: 1px solid #111418;
}

QScrollBar::handle:vertical {
    background-color: #2D333B;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #636A73;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #15181D;
    height: 12px;
    margin: 0px;
    border-top: 1px solid #111418;
}

QScrollBar::handle:horizontal {
    background-color: #2D333B;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #636A73;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Tables / Trees */
QTableView, QTreeView, QListView {
    background-color: #111418;
    color: #E0E6ED;
    border: 1px solid #111418;
    gridline-color: #1E2229;
    selection-background-color: #184F8D;
    selection-color: #FFFFFF;
}

QHeaderView::section {
    background-color: #15181D;
    color: #E0E6ED;
    padding: 6px;
    border: none;
    border-right: 1px solid #111418;
    border-bottom: 1px solid #111418;
}

QTableView::item:selected, QTreeView::item:selected {
    background-color: #184F8D;
    color: white;
}

/* Input fields */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #111418;
    color: #E0E6ED;
    border: 1px solid #1A1D21;
    padding: 4px;
    border-radius: 2px;
    selection-background-color: #184F8D;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #4A8CDA; /* Blue highlight on focus */
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QPushButton {
    background-color: #42474E;
    color: #E0E6ED;
    border: 1px solid #111418;
    padding: 5px 16px;
    border-radius: 2px;
}

QPushButton:hover {
    background-color: #2D333B;
    border: 1px solid #636A73;
}

QPushButton:pressed {
    background-color: #184F8D;
    border: 1px solid #306BB5;
}

/* MDI Area / Canvas Background */
QMdiArea {
    background-color: #212830;
}

