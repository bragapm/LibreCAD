/* AutoCAD Dark Theme for LibreCAD */
/* Window Background:  #1B2027 */
/* Toolbar Area:       #292D35  ← medium gray seperti mockup */
/* Toolbar Box:        #22262E  ← sedikit lebih gelap dari area */
/* Borders:            #383D48  ← abu-abu visible */
/* Text:               #CDD3DE */
/* Accent/Selected:    #184F8D (Blue) */
/* Canvas:             #1A1D24 */

QMainWindow, QDialog {
    background-color: #1B2027;
    color: #CDD3DE;
}

QWidget {
    background-color: #1B2027;
    color: #CDD3DE;
    font-family: "Segoe UI", "Inter", Arial, sans-serif;
    font-size: 11px;
}

/* Area Toolbar Atas */
QToolBar {
    background-color: #1B2027;
    border: none;
    spacing: 2px;
    padding: 2px;
    margin: 0px;
}

/* Khusus untuk toolbar vertikal (sebelah kiri), hilangkan kotaknya agar langsung icon saja */
QToolBar:vertical {
    background-color: transparent;
    border: none;
}

/* Tombol ekstensi (>>) pada toolbar */
QToolBar::extension-button {
    background-color: #bed1ca;
    image: url("data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABAAAAAQCAYAAAAf8/9hAAAAAXNSR0IArs4c6QAAAARnQU1BAACxjwv8YQUAAAAJcEhZcwAADsMAAA7DAcdvqGQAAAA+SURBVDhP3cvBDQAwDAKx7L80WcBCfUb18wQz/0mSl1bpoFbpoFbpoFbpoFbpoEYaqpGGaqShGmmoRhqq3bE751ep/XjovAAAAABJRU5ErkJggg==");
    width: 8px;
    border: 1px solid #4A5260;
    border-radius: 3px;
}

QToolBar::extension-button:hover {
    background-color: #363C47;
    border: 1px solid #4A5260;
}

/* Separator di dalam satu group */
QToolBar::separator {
    background-color: #383D48;
    width: 1px;
    margin: 4px 6px;
}

/* Handle untuk drag n drop toolbar (berupa titik-titik halus) */
QToolBar::handle {
    background-color: transparent;
    width: 6px;
    border-left: 2px dotted #4A5260;
    margin: 4px 6px;
}

/* Tombol icon di dalam toolbar */
QToolButton {
    background-color: transparent;
    color: #CDD3DE;
    border: 1px solid transparent;
    border-radius: 4px; /* Sudut halus pada saat dihover */
    padding: 4px;
    margin: 1px;
}

QToolButton:hover {
    background-color: #363C47;
    border: 1px solid #4A5260;
}

QToolButton:pressed, QToolButton:checked {
    background-color: #184F8D;
    border: 1px solid #306BB5;
    color: #FFFFFF;
}

/* Bagian indikator menu (dropdown arrow) di QToolButton untuk menu terpisah */
QToolButton::menu-button {
    border-left: 1px solid transparent;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    width: 12px;
}

QToolButton::menu-button:hover {
    border-left: 1px solid #4A5260;
    background-color: #434B57;
}

QToolButton::menu-arrow {
    image: url("data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAoAAAAKCAYAAACNMs+9AAAAAXNSR0IArs4c6QAAAARnQU1BAACxjwv8YQUAAAAJcEhZcwAADsMAAA7DAcdvqGQAAAAlSURBVChTY2AYePD/////6GIggFUcXRCdjwJgkngVwQBRiugHABXJG+Ut0cqDAAAAAElFTkSuQmCC");
}

/* Indikator visual permanen untuk tombol InstantPopup (grouping) */
QToolButton[popupMode="2"] {
    padding-right: 6px;
    border-right: 2px solid #383D48;
}

QToolButton[popupMode="2"]:hover {
    border-right: 2px solid #4A8CDA;
}

/* Indikator panah bawah untuk tombol InstantPopup */
QToolButton::menu-indicator {
    image: url("data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAoAAAAKCAYAAACNMs+9AAAAAXNSR0IArs4c6QAAAARnQU1BAACxjwv8YQUAAAAJcEhZcwAADsMAAA7DAcdvqGQAAAAlSURBVChTY2AYePD/////6GIggFUcXRCdjwJgkngVwQBRiugHABXJG+Ut0cqDAAAAAElFTkSuQmCC");
    subcontrol-origin: padding;
    subcontrol-position: bottom right;
    bottom: 2px;
    right: 2px;
}
QDockWidget {
    background-color: #1B2027;
    color: #CDD3DE;
    titlebar-close-icon: url();
    titlebar-normal-icon: url();
    border: 1px solid #383D48;
    font-size: 11px;
}

QDockWidget::title {
    background-color: #222730; /* Dibedakan sedikit lebih terang dari background panel (#1B2027) */
    color: #CDD3DE;
    padding: 6px 8px;
    text-align: left;
    border-bottom: none;
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 0.3px;
}

QDockWidget > QWidget {
    background-color: #1B2027;
}

/* Group section header di dalam dock (QLabel bold seperti 'User Coordinate Systems') */
QDockWidget QLabel[objectName="section_header"] {
    color: #8A9BB0;
    font-size: 9px;
    font-weight: 600;
    padding: 4px 6px 2px 6px;
    background-color: transparent;
    border-bottom: 1px solid #2C303A;
}

/* Filter / search input di dalam dock */
QDockWidget QLineEdit {
    background-color: #12151A;
    color: #CDD3DE;
    border: 1px solid #2C303A;
    border-radius: 2px;
    padding: 3px 6px;
    font-size: 11px;
    selection-background-color: #184F8D;
}

QDockWidget QLineEdit:focus {
    border: 1px solid #3A6EA8;
}

/* Menus */
QMenuBar {
    background-color: #1B2027;
    color: #CDD3DE;
    border-bottom: 1px solid #2C303A;
    font-size: 11px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 10px;
}

QMenuBar::item:selected {
    background-color: #2D333B;
}

QMenu {
    background-color: #1B2027;
    color: #CDD3DE;
    border: 1px solid #2C303A;
    font-size: 11px;
}

QMenu::item {
    padding: 4px 20px 4px 10px;
}

QMenu::item:selected {
    background-color: #184F8D;
    color: #FFFFFF;
}

/* Status Bar */
QStatusBar {
    background-color: #1B2027;
    color: #CDD3DE;
    border-top: 1px solid #2C303A;
}

QStatusBar::item {
    border: none;
    border-right: 1px solid #2C303A;
}

QStatusBar QLabel {
    color: #CDD3DE;
    padding: 0 8px;
    background-color: transparent;
}

/* Command Line — history area */
QTextEdit {
    background-color: #1B2027;
    color: #CDD3DE;
    border: none;
    padding: 4px 6px;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 11px;
    selection-background-color: #184F8D;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #2C303A;
    border-top: none;
    background-color: #1B2027;
}

QTabWidget::tab-bar {
    alignment: left;
}

QTabBar::tab {
    background-color: #12151A;
    color: #7A8899;
    padding: 5px 12px;
    border: 1px solid #2C303A;
    border-bottom: none;
    border-radius: 0px;
    margin: 0px 1px 0 0;
    font-size: 11px;
}

QTabBar::tab:selected {
    background-color: #1B2027;
    color: #E0E6ED;
    border-top: 2px solid #4A8CDA;
    border-left: 1px solid #2C303A;
    border-right: 1px solid #2C303A;
    border-bottom: none;
}

QTabBar::tab:hover:!selected {
    background-color: #22262E;
    color: #CDD3DE;
}

QTabBar::close-button {
    subcontrol-position: right;
    margin: 2px;
}

QTabBar::close-button:hover {
    background-color: #E81123;
    border-radius: 2px;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: #1B2027;
    width: 12px;
    margin: 0px;
    border-left: 1px solid #111418;
}

QScrollBar::handle:vertical {
    background-color: #2D333B;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #636A73;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #1B2027;
    height: 12px;
    margin: 0px;
    border-top: 1px solid #111418;
}

QScrollBar::handle:horizontal {
    background-color: #2D333B;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #636A73;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* Tables / Trees */
QTableView, QTreeView, QListView {
    background-color: #1B2027;
    color: #E0E6ED;
    border: 1px solid #1B2027;
    gridline-color: #2C303A;
    selection-background-color: #184F8D;
    selection-color: #FFFFFF;
}

QHeaderView::section {
    background-color: #222730; /* Di-highlight sedikit lebih terang dari isi tabel */
    color: #E0E6ED;
    padding: 6px;
    border: none;
    border-right: 1px solid #2C303A;
    border-bottom: 1px solid #2C303A;
    font-weight: bold; /* Ditambahkan agar teks header lebih tegas */
}

QTableView::item:selected, QTreeView::item:selected {
    background-color: #184F8D;
    color: white;
}

/* Input fields */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #222730; /* Sedikit lebih terang dari panel agar terlihat halus */
    color: #E0E6ED;
    border: 1px solid #2C303A; /* Border lebih soft */
    padding: 6px 8px;
    border-radius: 4px; /* Sudut sedikit membulat seperti mockup */
    selection-background-color: #184F8D;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #4A8CDA; /* Blue highlight on focus */
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QPushButton {
    background-color: #42474E;
    color: #E0E6ED;
    border: 1px solid #111418;
    padding: 5px 16px;
    border-radius: 4px;
}

/* Hilangkan kotak abu-abu tebal pada tombol di dalam panel tapi tetap beri garis batas (boundaries) tipis */
QDockWidget QPushButton {
    background-color: transparent;
    border: 1px solid #383D48; /* Garis tipis pembatas icon */
    border-radius: 4px; /* Sudut sedikit membulat */
    padding: 4px;
}

QDockWidget QPushButton:hover {
    background-color: #2D333B;
    border-radius: 4px;
}

QPushButton:hover {
    background-color: #2D333B;
    border: 1px solid #636A73;
}

QPushButton:pressed {
    background-color: #184F8D;
    border: 1px solid #306BB5;
}



/* Status Bar */
QStatusBar {
    background-color: #1B2027;
    color: #CDD3DE;
    border-top: 1px solid #2C303A;
}

QStatusBar::item {
    border: none;
    border-right: 1px solid #2C303A;
