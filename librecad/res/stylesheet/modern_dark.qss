}

/* MDI Area / Canvas Background */
QMdiArea {
    background-color: #212830;
}

/* Accurate Ribbon Styling */
#AccurateRibbonWidget {
    background-color: #1B2027;
}
#accurate_ribbon_toolbar QToolButton {
    background-color: transparent;
    border: none;
    color: #CDD3DE;
    padding: 4px;
    border-radius: 4px;
}
#accurate_ribbon_toolbar QToolButton:hover {
    background-color: #2D333B;
    border: 1px solid #4A5260;
}
#accurate_ribbon_toolbar QToolButton:pressed {
    background-color: #184F8D;
}


#accurate_ribbon_toolbar QComboBox {
    padding: 2px 4px;
}

